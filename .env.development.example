# Template for local dev config. Copy to .env.development (gitignored).
#   cp .env.development.example .env.development
#
# Vite loads .env.development ONLY in dev mode (`vite dev`), never in `vite build`,
# so values here never leak into the released bundle. Production builds fall back
# to same-origin (window.location.origin) — correct for the UI embedded in the relay binary.
#
# Point the admin UI at a control API base during local dev, overriding the
# runtime config document (requires permissive CORS + SameSite=None cookies on
# the backend). Useful when the backend's config doc advertises a stale base,
# e.g. routes moved under /api. Leave unset to trust the config document.
# VITE_CONTROL_API_URL=https://relay-control.example.dev/api

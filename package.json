{
  "name": "relay-ui",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "check": "biome check ./src",
    "ci": "bun run typecheck && bun run lint",
    "gen:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:8080/openapi.json} -o src/api/types.gen.ts",
    "gen:api:live": "curl -sk https://relay.wyolet.dev/openapi.json | bun x openapi-typescript /dev/stdin -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.5",
    "@tanstack/react-router": "latest",
    "lucide-react": "^0.545.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.80.5",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}

{
  "name": "relay-ui",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "Operator admin UI for Wyolet Relay — embedded into the Relay binary and served at /ui/.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wyolet/relay-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyolet/relay-ui.git"
  },
  "bugs": {
    "url": "https://github.com/wyolet/relay-ui/issues"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "check": "biome check ./src",
    "test": "bun test src/",
    "test:e2e": "playwright test",
    "ci": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "sugar-high": "^1.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}

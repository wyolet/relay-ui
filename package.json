{
  "name": "relay-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "check": "biome check ./src",
    "test": "bun test",
    "ci": "bun run typecheck && bun run lint && bun run test",
    "gen:api": "openapi-typescript ${OPENAPI_URL:-http://localhost:8080/openapi.json} -o src/api/types.gen.ts",
    "gen:api:live": "curl -sk https://relay-control-api.wyolet.dev/openapi.json | bun x openapi-typescript /dev/stdin -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.80.5",
    "@tanstack/react-router": "latest",
    "@wyolet/design": "../design",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.80.5",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
